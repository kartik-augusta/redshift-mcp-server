# Redshift connection details
RS_HOST=your-cluster.region.redshift.amazonaws.com
RS_PORT=5439
RS_DB=your_database_name
RS_USER=your_readonly_user
RS_PASS=your_password

# Schema access control (comma-separated list of allowed schemas)
ALLOWED_SCHEMAS=gold_capsaai,gold_capsaai_cefi,gold_capsaai_cspp,report_capsaai
DEFAULT_SCHEMA=gold_capsaai

# Query limits
MAX_ROWS=500
MAX_EXPORT_ROWS=5000

# Resilience tuning
MAX_RETRIES=3
CONNECT_TIMEOUT=15

# SSH Tunnel configuration (for VPC/private Redshift clusters)
# Enable SSH tunneling by setting SSH_TUNNEL=true
SSH_TUNNEL=false
SSH_HOST=your-bastion-host.example.com
SSH_PORT=22
SSH_USER=your_ssh_username
SSH_KEY_FILE=/path/to/your/ssh-key.pem
SSH_KEEPALIVE=20
# Optional: SSH password (if not using key-based auth)
# SSH_PASSWORD=your_ssh_password
# Local port for tunnel (default: 5439)
LOCAL_PORT=5439
PORT_SCAN_RANGE=10

# Gemini API key (used by legacy client.py)
# GEMINI_API_KEY=your_gemini_api_key

# AWS Bedrock (for Streamlit AI chat)
BEDROCK_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS profile name (leave empty to use default profile or EC2 IAM role)
# AWS_PROFILE=your-profile-name
# Alternatively, provide explicit access keys (leave empty if using profile)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key