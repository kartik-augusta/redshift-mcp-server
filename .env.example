# ─────────────────────────────────────────────────────────────────────────────
# Redshift MCP Server — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values.  Required variables are marked [REQUIRED].

# ── Transport ────────────────────────────────────────────────────────────────
# "stdio" for local dev / CLI clients, "http" for remote Streamable HTTP
TRANSPORT=stdio
HOST=0.0.0.0
PORT=8001
# [REQUIRED when TRANSPORT=http] Public URL of the server (no placeholders!)
# MCP_PUBLIC_URL=https://mcp.example.com

# ── Authentication ───────────────────────────────────────────────────────────
# "oidc" for production OIDC (works with Cognito, Entra ID, Okta, etc.)
# "api-key" for a shared static key (not recommended for production)
# "none" is only valid for local stdio development
AUTH_MODE=none

# Static API key for local/dev use (x-api-key header); requires AUTH_MODE=api-key.
# MCP_API_KEY=your-dev-api-key-here

# ── OIDC Configuration (generic — works with any OIDC provider) ─────────────
# [REQUIRED when AUTH_MODE=oidc]
#
# Cognito example:
#   OIDC_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/<pool-id>
#   OIDC_AUDIENCE=<app-client-id>
#   OIDC_GROUP_CLAIM=cognito:groups
#
# Entra ID example (with App Roles):
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   OIDC_AUDIENCE=<application-id>
#   OIDC_ROLES_CLAIM=roles
#
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URI=                    # Auto-discovered from issuer if empty
# OIDC_REQUIRED_SCOPES=             # Comma-separated (e.g., openid,profile)
# OIDC_GROUP_CLAIM=groups           # Claim name for group membership
# OIDC_ROLES_CLAIM=roles            # Claim name for app role assignments (Entra ID)

# ── Authorization ────────────────────────────────────────────────────────────
# Required for HTTP. Maps Entra app role values / IdP groups to tools and schemas.
# Entra App Roles are compared to the exact values in the token's "roles" claim
# (for example: capsa-analysts), not the display name or app role object ID.
# See policy.yaml.example for format.
# AUTHZ_POLICY_PATH=policy.yaml

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins.  Empty = no CORS headers.
# CORS_ORIGINS=https://app.example.com

# ── Redshift Connection [REQUIRED] ──────────────────────────────────────────
RS_HOST=your-cluster.region.redshift.amazonaws.com
RS_PORT=5439
RS_DB=your_database_name
RS_USER=your_readonly_user
RS_PASS=your_password

# Alternatively, use AWS Secrets Manager (mutually exclusive with RS_PASS):
# DB_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:name

# ── Connection Pool ──────────────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# ── Schema Access Control (comma-separated list of allowed schemas) ──────────
ALLOWED_SCHEMAS=gold_capsaai,gold_capsaai_cefi,gold_capsaai_cspp,report_capsaai,report_insight
DEFAULT_SCHEMA=gold_capsaai

# ── Query Limits ─────────────────────────────────────────────────────────────
MAX_ROWS=500
MAX_EXPORT_ROWS=5000
MAX_RESPONSE_BYTES=10485760

# ── Resilience ───────────────────────────────────────────────────────────────
MAX_RETRIES=3
CONNECT_TIMEOUT=15

# ── SSH Tunnel (for VPC/private Redshift clusters) ───────────────────────────
SSH_TUNNEL=false
SSH_HOST=your-bastion-host.example.com
SSH_PORT=22
SSH_USER=your_ssh_username
SSH_KEY_FILE=/path/to/your/ssh-key.pem
SSH_KEEPALIVE=20
# SSH_PASSWORD=your_ssh_password
LOCAL_PORT=5439
PORT_SCAN_RANGE=10

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── Shutdown ─────────────────────────────────────────────────────────────────
SHUTDOWN_GRACE_PERIOD_S=30
